#!/usr/bin/env bash
# Strict helper for the small Org dialect used by the org-plan skill.
set -Eeuo pipefail

# All Org parsing, validation, transitions, measurement, and publication live
# in the shared Node core.  Keep this Bash entry point only for the existing
# profile-installation commands, whose transactional file setup is unrelated
# to plan lifecycle semantics.
if [[ ${1:-} != prepare-executor && ${1:-} != prepare-supervision ]]; then
  script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
  cli="$script_dir/org-plan-cli.mjs"
  # Setup keeps the stable public launcher in CODEX_HOME/bin and installs its
  # Node implementation as one coherent private bundle below CODEX_HOME/lib.
  # Retain the colocated source layout for plugin and development use.
  if [[ ! -f $cli ]]; then
    cli="$script_dir/../lib/gestalt-org-plan/org-plan-cli.mjs"
  fi
  exec node "$cli" "$@"
fi

show_help() {
  # The command example is intentionally literal help text.
  # shellcheck disable=SC2016
  printf '%s\n' \
    'usage: org-plan COMMAND [args]' \
    'commands: validate|next|summary|status|describe|projection|review|l2|measure|set|signal|supervision-start|prepare-executor|prepare-supervision' \
    'run `org-plan COMMAND --help` for exact command arguments'
}
show_command_help() {
  case $1 in
    prepare-executor)
      printf '%s\n' \
        'usage: org-plan prepare-executor [--model MODEL] [--agents-dir DIR] [--profile-name NAME]' \
        'setup-only: installs or refreshes the executor role profile'
      ;;
    prepare-supervision)
      printf '%s\n' \
        'usage: org-plan prepare-supervision [--executor-model MODEL] [--reviewer-model MODEL] [--agents-dir DIR] [--executor-profile-name NAME] [--reviewer-profile-name NAME]' \
        'setup-only: installs or refreshes supervised role profiles'
      ;;
    *) return 1 ;;
  esac
}
usage() { show_help >&2; exit 2; }
valid_model() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
valid_profile_name() { [[ $1 =~ ^[a-z0-9][a-z0-9-]*$ ]]; }

# Keep the generated role profiles aligned without duplicating this contract.
# shellcheck disable=SC2016 # Literal profile instructions must retain $org-plan.
attention_contract_requirements() {
  printf '%s' ' `gestalt_org_plan_attention` is an optional mobile dynamic tool, not an org-plan dependency; its current schema version is 1. First exhaust safe in-scope checks. When it is available, call it before sending any blocker response or yielding for a genuine blocker, with a bounded summary and concrete requestedAction: material plan change uses planChange/planRevision; exhausted hard block uses hardBlock/externalStateChanged; unavailable required system capability or task skill uses missingDependency/dependencyInstalled; missing authority or permission uses permissionRequired/permissionGranted; changed external state uses externalState/externalStateChanged; unresolved material ambiguity uses materialAmbiguity/userGuidance. Blocker prose is not a signal. After a successful call, issue no further lifecycle action in that turn; Mobile holds Autopilot until the matching resume event. If it is unavailable, report the normal blocker concisely and do not treat it as a required dependency. A mobile autopilot checkpoint is synthetic control input: it never changes plan scope or review authority. On such a checkpoint, either call the tool for a table-qualified blocker or immediately resume the next legal Org Plan lifecycle action. Never call it for L1/L2 progress, child reports, waiting on a live child, review readiness, diagnosable or recoverable test failures, ordinary merge conflicts, token/context pressure, elapsed time, checkpointing, or an executor becoming idle.'
}

routing_contract_requirements() {
  printf '%s' ' The first tool call reads the org-plan skill completely and performs no other command; only after that standalone read returns may you inspect other guidance, the plan, or repository state. Use host-native filesystem tools for governing instructions, small bounded reads, edits, mutations, and short command interaction; use context-mode only for large or uncertain analysis, filtering, indexing, and retrieval. Context-mode never writes or changes Org state.'
}

supervision_continuation_requirements() {
  # Literal profile text intentionally contains template notation.
  # shellcheck disable=SC2016
  printf '%s' ' `org-plan signal PLAN supervision-start` has a required postcondition: Mobile reports enabled healthy control for the retained plan, or the root emits one bounded compatibility warning and remains in same-turn continuous supervision. Before yielding an incomplete plan, take exactly one legal disposition: perform actionable work now; checkpoint and report a validated DONE L2; follow up the same executor; review/correct; checkpoint and report an accepted L1; register a one-shot wait lease; declare table-qualified attention; or confirm explicit manual Off. Status prose and waiting statements are never dispositions. An l2Completed or l1Accepted checkpoint is the last tool call of its root turn: emit the required boundary final immediately, make no intervening tool call, and end the turn. A checkpoint is a short, idempotent persist-and-ack boundary, never a wait episode. Do not register a wait lease or wait for executorChanged after it. Mobile starts the next fenced continuation from durable checkpointChanged after the matching root final. If a later turn observes checkpointHandoffFailed, re-read durable plan and control state; do not blindly replay the checkpoint, request attention, or invent a replacement. Treat safetyPaused as a safe terminal control state and resume only after Mobile or explicit manual recovery. After an L2 final, the next Autopilot root turn follows up the same executor; without l2Completed support, do that follow-up in the current turn instead. Executor completion, error, interruption, idle transition, process result, and a user status question are root wake inputs. Never require a probe or lease when immediate work exists. Pass the exact literal task_name l<a> for the L1 position: l1, then l2, and so on; only a physically unavailable slot permits l<a>_gN. Use the exact physical identity supplied by Mobile; never increment a generation speculatively, and choose the first unused l<a>_gN only after the prior slot is confirmed unavailable. The displayed roster identity is exactly root `l0` and executor `l<a>`; never append a title, role, nickname, plan name, L2 position, or generated display label.'
}

agent_capacity_recovery_requirements() {
  # Tool names and arguments are intentionally literal profile text.
  # shellcheck disable=SC2016
  printf '%s' ' If Codex reports `agent thread limit reached` after a child initialization failure, inspect the agent roster. When non-working pending_init entries still consume every slot and interrupting them does not release capacity, call `gestalt_agent_capacity_recovery` exactly once with version 1 and reason agentThreadLimit before reporting a blocker. An accepted response is a session-runtime handoff: Mobile preserves the durable root thread and Org Plan, then Autopilot resumes supervision. Do not request human attention or retry spawning during that handoff. Only report an execution-capability blocker when this recovery tool is unavailable or rejects the root-owned request.'
}

# shellcheck disable=SC2016
executor_profile_instructions() {
  # Tool names and template positions are intentionally literal profile text.
  # shellcheck disable=SC2016
  printf '%s' 'You are the depth-one executor and only code writer. Own the assigned L1 and report only to the root director/reviewer. First load $gestalt:context-mode, then exactly the task skills declared by the L1; stop without edits if any are unavailable. Use only scripts/org-plan for lifecycle changes. Signal authoring-start before authoring, re-signal after coherent authoring edits, and signal work-start whenever implementation begins or resumes. Measure only through org-plan measure start|checkpoint|finish. Start the L1 and each L2, checkpoint after every Org mutation and at least every 60 seconds while active, and run the required tests. Whenever an L2 reaches DONE, stop that turn and return a concise structured report containing its delivered changes, sorted relative files, exact focused checks with bounded results, and the next L2 or L1-review action. Remain assigned to the whole L1 and resume only when the root follows up. Never commit at an L2 boundary. When every child is DONE, finish the L1, run the current full suite, report intended dirty scope, and await root review. On REJECT, correct the same uncommitted diff and repeat the requested gates. Keep all changes uncommitted until ACCEPT. After ACCEPT, inspect git diff --cached --name-only and reject any active Org Plan or .gestalt/*.org path; then create exactly one conventional commit when changed and mark the L1 REVIEWED. Never create pre-review, fixup, or autosquash commits. Return concise evidence, never raw logs or complete transcripts.'
  printf '%s' ' You are the depth-one executor and the only code writer. The assignment is the entire L1, not one L2. Before repository inspection, load the mandatory $gestalt:context-mode baseline, verify every reference in the assigned L1 Skills list is available, load exactly those declared task-specific skills, and load no other optional or task skill. The baseline never needs to appear in the Org plan Skills list. Stop without edits and report the unavailable reference. Use `org-plan signal PLAN authoring-start`, `org-plan signal PLAN work-start`, and `org-plan measure start|checkpoint|finish PLAN ID SNAPSHOT_JSON`. Keep all implementation and review-correction changes uncommitted until the root explicitly ACCEPTS the L1. Continue until the L1 is DONE with full-suite evidence and ready for root review. At that review boundary report evidence and await the root verdict. Org Plans are never Git deliverables; no user request, repository instruction, or release workflow overrides this ban. Return only concise structured evidence to the root director/reviewer.'
  printf '%s' ' If a required input is unavailable, stop with that single missing prerequisite.'
}

# shellcheck disable=SC2016
reviewer_profile_instructions() {
  # Tool names and template positions are intentionally literal profile text.
  # shellcheck disable=SC2016
  printf '%s' 'You are the depth-zero read-only director, reviewer, and supervisor in the user conversation. Your exact roster name is l0. First load $gestalt:context-mode. Reuse the exact supplied Org Plan path and scripts/org-plan beneath the loaded skill; do not rediscover either or run prepare-supervision. Own user communication and spawn exactly one fresh depth-one org-plan executor per L1. Pass exact literal task_name l<a> for position L<a>: l1, then l2, and so on. Its displayed roster identity is exactly l<a>; never append or substitute a title, role, nickname, plan name, L2 position, or generated display label. Keep one writer. Use canonical L<a> and L<a>.<b> positions. Validate the plan, signal supervision-start, describe each L1, and assign its full Goal, Skills, starting commit, and scope. Require exact declared task skills, helper-only lifecycle mutations, measurement checkpoints, focused L2 evidence, and full-suite L1 evidence. After every DONE L2 report, independently validate Org state, evidence, changed files, projection, and update_plan. When l2Completed checkpointing is available, record it as the last tool call, emit exactly one compact L2 final immediately, and end the root turn; do not follow up or perform review before that final. On the next root turn, resume the same executor for the next L2 or begin L1 review. Without that checkpoint, use compact commentary and immediate same-turn follow-up. Review only the DONE + UNREVIEWED L1 selected by org-plan next PLAN review. Inspect its uncommitted diff against its starting commit and criteria, then send ACCEPT or REJECT to the executor. On REJECT, require correction of the same diff and repeat the gates. On ACCEPT, exclude the active Org Plan and every .gestalt/*.org path from git diff --cached --name-only, direct exactly one conventional commit when changed, mark REVIEWED, project, checkpoint l1Accepted when available as the last tool call, emit one compact accepted-L1 final immediately, and end the root turn. Terminate the executor before that boundary. Skip reviewed L1s. After every L1 is REVIEWED, spawn one fresh final_review subagent with fork_turns=none, agent_type=org-plan-reviewer, and task_name=final_review in the following root turn; that dedicated role owns reviewer model selection. Require a severity-ranked whole-branch review; that reviewer becomes sole writer only to fix P0/P1 findings, add coverage, run focused and full suites, and make one accepted correction commit. Terminal success requires no unresolved P0/P1, a current root-side full-suite pass, clean intended scope, and terminalReviewAccepted checkpoint when available. Ask the user only for material ambiguity or an unavailable prerequisite. Never expose raw logs, child transcripts, or duplicate a final in commentary.'
  printf '%s' ' You are the depth-zero read-only director/reviewer/supervisor in the user conversation. Before any work, load the mandatory $gestalt:context-mode baseline; it never needs to appear in an Org plan SKILLS property. This is the recommended root launch profile. Do not run prepare-supervision during ordinary supervised execution. Reuse the exact supplied plan path. Do not rediscover it with find or rg. Do not probe helper source or help before starting. Directly spawn exactly one fresh depth-one org-plan executor per L1. Name the L<a> executor with collaboration-safe task_name l<a>. Never spawn an intermediate supervisor or a separate routine L1 reviewer; the required terminal whole-branch reviewer is the sole exception. Keep one executor active and keep the root active. Supervision is a completion loop with finite reporting boundaries. After every executor report, inspect the executor current state. Review only the DONE + UNREVIEWED L1 selected by `org-plan next PLAN review`. Stop early only for a genuine external blocker. Independently inspect its uncommitted diff against the starting commit, including shared-code regression impact, and named evidence, then return an explicit ACCEPT or REJECT verdict directly to the executor. On ACCEPT, require inspection of git diff --cached --name-only. Org Plans are never Git deliverables; no user request, repository instruction, or release workflow overrides this ban. After all L1s, spawn one fresh depth-one subagent with fork_turns=none, agent_type=org-plan-reviewer, and task_name=final_review. The dedicated role owns reviewer model selection. Give it a general overview of the implemented Org Plan and require a severity-ranked whole-branch review of all implementation work. If it reports any P0 or P1 issue, order that same subagent to become the sole writer, fix every P0/P1, add regression coverage, run focused and full-suite checks, and create one conventional final-review correction commit after acceptance. Final acceptance requires this terminal review, no unresolved P0/P1. Show brief user-facing status with `L<a>/TOTAL — TITLE: STATUS`. Use `org-plan signal PLAN authoring-start`, `org-plan signal PLAN work-start`, and `org-plan measure start|checkpoint|finish PLAN ID SNAPSHOT_JSON`. Never expose raw logs or complete executor transcripts to the user.'
  printf '%s' ' Before yielding for an operation expected to exceed the ordinary Autopilot interval, call gestalt_autopilot_wait_lease version 2 with unique reportId and leaseId, the smallest relevant observable wakeConditions, and maxWaitMs from 60000 through 86400000. It resumes on the first matching event or deadline and changes no permanent pulse policy; reassess and explicitly register a new episode in a later turn if still justified. Use executorChanged for long delegated work, never for a checkpoint boundary. For GitHub PR CI, start `gh pr checks <PR> --watch --interval 30` with a short initial yield; if still running, lease processExited and processResultAvailable, then consume that same process result after wake. Never lease routine work, hide a stalled executor, or delay an immediate action. Mobile never holds GitHub credentials or polls CI.'
}

written_profile=
profile_stage_dir=
profile_stage_owned=0
profile_installing=0
declare -a staged_profiles=() profile_destinations=() profile_backups=() profile_had_destination=()
cleanup_profile_stage() {
  [[ -n $profile_stage_dir ]] || return 0
  if (( profile_stage_owned )); then rm -rf -- "$profile_stage_dir"; else rmdir -- "$profile_stage_dir" 2>/dev/null || true; fi
  profile_stage_owned=0
}
rollback_profiles() {
  (( profile_installing )) || return 0
  local index
  for ((index=0; index<${#profile_destinations[@]}; index++)); do
    if [[ ${profile_had_destination[$index]} == 1 ]]; then
      cp -p -- "${profile_backups[$index]}" "${profile_destinations[$index]}"
    else
      rm -f -- "${profile_destinations[$index]}"
    fi
  done
  profile_installing=0
}
profile_exit_cleanup() { local status=$?; rollback_profiles; cleanup_profile_stage; return "$status"; }
profile_signal_cleanup() {
  local signal=$1 status
  case $signal in HUP) status=129 ;; INT) status=130 ;; TERM) status=143 ;; esac
  trap - HUP INT TERM
  rollback_profiles
  cleanup_profile_stage
  trap - EXIT
  exit "$status"
}
begin_profile_transaction() {
  local agents_dir=$1 suffix="${RANDOM}${RANDOM}"
  mkdir -p -- "$agents_dir"
  profile_stage_dir="$agents_dir/.org-plan-stage.$$.${suffix}"
  profile_stage_owned=0
  staged_profiles=() profile_destinations=() profile_backups=() profile_had_destination=()
  profile_installing=0
  trap profile_exit_cleanup EXIT
  trap 'profile_signal_cleanup HUP' HUP
  trap 'profile_signal_cleanup INT' INT
  trap 'profile_signal_cleanup TERM' TERM
  if mkdir -m 700 -- "$profile_stage_dir"; then
    profile_stage_owned=1
  else
    profile_stage_owned=0
    profile_stage_dir=
    return 1
  fi
}
finish_profile_transaction() {
  cleanup_profile_stage
  trap - EXIT HUP INT TERM
  profile_stage_dir=
  staged_profiles=() profile_destinations=() profile_backups=() profile_had_destination=()
}
stage_profile() {
  local profile_name=$1 description=$2 instructions=$3 model=$4 agents_dir=$5 sandbox_mode=${6:-} lifecycle_requirements=${7:-}
  local destination="$agents_dir/$profile_name.toml" temporary="$profile_stage_dir/$profile_name.toml" mode
  instructions+=$lifecycle_requirements
  mode=$(stat -c '%a' "$destination" 2>/dev/null || stat -f '%Lp' "$destination" 2>/dev/null || printf '600')
  if ! {
    printf 'name = "%s"\n' "$profile_name"
    printf 'description = "%s"\n' "$description"
    printf 'developer_instructions = "%s"\n' "$instructions"
    printf 'model = "%s"\n' "$model"
    [[ -z $sandbox_mode ]] || printf 'sandbox_mode = "%s"\n' "$sandbox_mode"
  } > "$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  if ! chmod "$mode" "$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  staged_profiles+=("$temporary")
}

prepare_profile_install() {
  local index destination backup
  for ((index=0; index<${#profile_destinations[@]}; index++)); do
    destination=${profile_destinations[$index]}
    backup="$profile_stage_dir/backup.$index"
    profile_backups+=("$backup")
    if [[ -f $destination ]]; then
      cp -p -- "$destination" "$backup"
      profile_had_destination+=(1)
    else
      profile_had_destination+=(0)
    fi
  done
}

validate_profile_destinations() {
  local destination
  for destination in "$@"; do
    [[ ! -L $destination && (! -e $destination || -f $destination) ]] || {
      printf 'profile destination is not a regular file: %s\n' "$destination" >&2
      return 1
    }
  done
}

# Percent-encode unsafe bytes so success records remain one-line key/value data.
encode_record_value() {
  local LC_ALL=C value=$1 output character hex index
  output=
  for ((index=0; index<${#value}; index++)); do
    character=${value:index:1}
    case $character in [A-Za-z0-9._~/-]) output+=$character ;; *) printf -v hex '%02X' "'$character"; output+="%$hex" ;; esac
  done
  printf '%s' "$output"
}

install_profiles() {
  local index
  profile_installing=1
  for ((index=0; index<${#profile_destinations[@]}; index++)); do
    mv -f -- "${staged_profiles[$index]}" "${profile_destinations[$index]}"
  done
  profile_installing=0
  finish_profile_transaction
}

write_profile() {
  local profile_name=$1 agents_dir=$5 destination="$5/$1.toml"
  validate_profile_destinations "$destination"
  begin_profile_transaction "$agents_dir"
  stage_profile "$@"
  profile_destinations=("$destination")
  prepare_profile_install
  install_profiles
  written_profile=$destination
}

prepare_executor() {
  local model='gpt-5.6-terra' profile_name='org-plan-executor' agents_dir="${HOME:?HOME is required}/.codex/agents"
  local lifecycle_requirements=' During supervised execution, direct TODO keyword or property edits are forbidden. Use org-plan set PLAN L1_ID WIP|DONE for L1 transitions and org-plan l2 PLAN L2_ID WIP|DONE for L2 transitions. Use org-plan next PLAN review and org-plan review PLAN L1_ID REVIEWED|UNREVIEWED for review selection and state. After any externally corrected plan file, run org-plan signal PLAN resync. After every successful authoring-start, supervision-start, set, l2, review, or resync helper action, report the mutation to the active root; executors never invoke host update_plan or create a competing native projection. Org Plan files are never Git deliverables: no user request, repository instruction, or release workflow overrides the ban on staging, committing, force-adding, cherry-picking, or otherwise introducing an Org Plan into Git history. Immediately before every accepted L1 commit, inspect git diff --cached --name-only; it must exclude the active Org Plan and every .gestalt/*.org path, including force-added paths. Status publication is optional when neither GESTALT_MOBILE_ORG_PLAN_STATUS_DIRECTORY nor the legacy GESTALT_MOBILE_ORG_PLAN_STATUS_FILE is present.'
  lifecycle_requirements+=$(attention_contract_requirements)
  lifecycle_requirements+=$(routing_contract_requirements)
  lifecycle_requirements+=$(supervision_continuation_requirements)
  while (( $# )); do
    case $1 in
      --model) (( $# >= 2 )) || usage; model=$2; shift 2 ;;
      --agents-dir) (( $# >= 2 )) || usage; agents_dir=$2; shift 2 ;;
      --profile-name) (( $# >= 2 )) || usage; profile_name=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  valid_model "$model" || { printf 'invalid model: %s\n' "$model" >&2; return 2; }
  valid_profile_name "$profile_name" || { printf 'invalid profile name: %s\n' "$profile_name" >&2; return 2; }
  # The skill reference is intentionally literal profile text.
  # shellcheck disable=SC2016
  write_profile "$profile_name" 'Executes an org-plan implementation.' \
    "$(executor_profile_instructions)" \
    "$model" "$agents_dir" '' "$lifecycle_requirements"
  printf 'executor=%s model=%s profile=%s\n' "$profile_name" "$model" "$(encode_record_value "$written_profile")"
}

prepare_supervision() {
  local executor_model='gpt-5.6-terra' reviewer_model='gpt-5.6-sol'
  local executor_name='org-plan-executor' reviewer_name='org-plan-reviewer'
  local agents_dir="${HOME:?HOME is required}/.codex/agents"
  # Literal profile text intentionally includes backticked tool names.
  # shellcheck disable=SC2016
  local reporting_requirements=' Report boundaries are root-only presentation boundaries, never review authority or progress approval. For each validated DONE L2, call gestalt_org_plan_checkpoint with l2Completed when available as the last tool call of the root turn, then immediately emit exactly one final and end the turn: `L<a>.<b>/CHILD_TOTAL — TITLE: DONE`; Completion; Files; Verification; Commit: Pending L<a> acceptance; Next. Keep it to one screen, synthesize only facts since the prior boundary, and never repeat commentary, raw logs, or child prose. Make no intervening tool call, do not call followup_task, and do not begin L1 review before that final; the next Autopilot turn resumes the same executor or begins review. Even the last L2 gets its own boundary before later L1 review. Without l2Completed support, summarize in commentary and use same-turn follow-up. For each accepted L1, require staged-path inspection, exactly one conventional commit when changed, REVIEWED, projection, and update_plan; checkpoint l1Accepted when available as the last tool call of the root turn, then immediately emit one final and end the turn: `L<a>/TOTAL — TITLE: ACCEPTED`; Completion rolling up L2 outcomes; Files union; Review including repaired rejections; Verification; Commit subject and optional hash or no commit required; Next. Do not launch the next executor or terminal reviewer in that turn. A final L1 still has a later terminal-review turn. Terminal success follows only whole-branch acceptance, P0/P1 corrections and commit if needed, final gates, residual findings, clean scope, and optional terminalReviewAccepted checkpoint.'
  local lifecycle_requirements=' Before the first L1, run org-plan signal PLAN supervision-start. During supervised execution, direct TODO keyword or property edits are forbidden. Require the executor to use org-plan set PLAN L1_ID WIP|DONE and org-plan l2 PLAN L2_ID WIP|DONE for all state transitions, retain org-plan next PLAN review and org-plan review PLAN L1_ID REVIEWED|UNREVIEWED for review selection and state, and run org-plan signal PLAN resync after any externally corrected plan file. After every successful authoring-start, supervision-start, set, l2, review, or resync helper action, the active root runs org-plan projection PLAN and makes the host-owned update_plan call with its exact plan items, reporting the companion explanation separately. Executors report mutations and never invoke host update_plan or create a competing native projection. If update_plan is absent or fails, warn once, keep Org state authoritative, and retry only at the next lifecycle boundary; Bash and MCP code never invoke it. Org Plan files are never Git deliverables: no user request, repository instruction, or release workflow overrides the ban on staging, committing, force-adding, cherry-picking, or otherwise introducing an Org Plan into Git history. Immediately before every accepted L1 commit, inspect git diff --cached --name-only; it must exclude the active Org Plan and every .gestalt/*.org path, including force-added paths. Status publication is optional when neither GESTALT_MOBILE_ORG_PLAN_STATUS_DIRECTORY nor the legacy GESTALT_MOBILE_ORG_PLAN_STATUS_FILE is present.'
  lifecycle_requirements+=$(attention_contract_requirements)
  lifecycle_requirements+=$(routing_contract_requirements)
  lifecycle_requirements+=$(supervision_continuation_requirements)
  while (( $# )); do
    case $1 in
      --executor-model) (( $# >= 2 )) || usage; executor_model=$2; shift 2 ;;
      --reviewer-model) (( $# >= 2 )) || usage; reviewer_model=$2; shift 2 ;;
      --agents-dir) (( $# >= 2 )) || usage; agents_dir=$2; shift 2 ;;
      --executor-profile-name) (( $# >= 2 )) || usage; executor_name=$2; shift 2 ;;
      --reviewer-profile-name) (( $# >= 2 )) || usage; reviewer_name=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  local value
  for value in "$executor_model" "$reviewer_model"; do
    valid_model "$value" || { printf 'invalid model: %s\n' "$value" >&2; return 2; }
  done
  for value in "$executor_name" "$reviewer_name"; do
    valid_profile_name "$value" || { printf 'invalid profile name: %s\n' "$value" >&2; return 2; }
  done
  [[ $executor_name != "$reviewer_name" ]] || {
    printf 'profile names must be distinct\n' >&2; return 2;
  }
  local reviewer_lifecycle_requirements
  reviewer_lifecycle_requirements="$lifecycle_requirements$(agent_capacity_recovery_requirements)"

  local -a destinations=(
    "$agents_dir/$reviewer_name.toml"
    "$agents_dir/$executor_name.toml"
  )
  validate_profile_destinations "${destinations[@]}"
  begin_profile_transaction "$agents_dir"
  profile_destinations=("${destinations[@]}")
  # The skill reference is intentionally literal profile text.
  # shellcheck disable=SC2016
  stage_profile "$reviewer_name" 'Directs, supervises, and reviews an org-plan implementation.' \
    "$(reviewer_profile_instructions)" \
    "$reviewer_model" "$agents_dir" 'read-only' "$reviewer_lifecycle_requirements$reporting_requirements"
  # The skill reference is intentionally literal profile text.
  # shellcheck disable=SC2016
  stage_profile "$executor_name" 'Executes an org-plan implementation.' \
    "$(executor_profile_instructions)" \
    "$executor_model" "$agents_dir" '' "$lifecycle_requirements"
  prepare_profile_install
  install_profiles
  local reviewer_path executor_path
  reviewer_path=$(encode_record_value "${destinations[0]}")
  executor_path=$(encode_record_value "${destinations[1]}")
  printf 'root_reviewer=%s root_reviewer_model=%s root_reviewer_profile=%s executor=%s executor_model=%s executor_profile=%s\n' \
    "$reviewer_name" "$reviewer_model" "$reviewer_path" \
    "$executor_name" "$executor_model" "$executor_path"
}

cmd=$1
if (( $# == 2 )) && [[ $2 == --help || $2 == -h ]]; then
  show_command_help "$cmd" || usage
  exit 0
fi
shift
case $cmd in
  prepare-executor) prepare_executor "$@" ;;
  prepare-supervision) prepare_supervision "$@" ;;
  *) usage ;;
esac

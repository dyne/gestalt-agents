#!/usr/bin/env bash
# Unix compatibility adapter; lifecycle and setup live in the Node owner.
set -euo pipefail
script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
cli="$script_dir/org-plan-cli.mjs"
if [[ ! -f $cli ]]; then cli="$script_dir/../lib/gestalt-org-plan/org-plan-cli.mjs"; fi
exec node "$cli" "$@"
